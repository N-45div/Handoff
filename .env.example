# Hugging Face token with access to aidigestorg/ai-village
# https://huggingface.co/datasets/aidigestorg/ai-village
HF_TOKEN=

# Gitignored local slice directory
HANDOFF_DATA_DIR=./data

# Zetaris — same names as getting-started/.env.example
# UI origin (SQL Editor helpers). Raw API is port 8888.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_USER_AGENT=

# Meterless Runtime (Nemotron via Nightshift)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_TOKEN=
METERLESS_APP=handoff
