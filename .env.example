# Hugging Face token with access to aidigestorg/ai-village
# https://huggingface.co/datasets/aidigestorg/ai-village
HF_TOKEN=

# Gitignored local slice directory
HANDOFF_DATA_DIR=./data

# Zetaris — same names as getting-started/.env.example
# UI origin (SQL Editor helpers). Raw API is port 8888.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_USER_AGENT=

# Meterless Nightshift (OpenAI-compatible). rt-local is rejected.
# Token is the runtime proxy token from the Nightshift app, not a model key.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_TOKEN=
METERLESS_APP=handoff
METERLESS_MODEL=meterless/deep
METERLESS_VL_MODEL=meterless/deep

# Every model call goes through Meterless to NVIDIA Nemotron. Add an NVIDIA key
# (build.nvidia.com) in Nightshift: Setup, Providers. Optional per-step model overrides:
# HANDOFF_EXTRACT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# HANDOFF_JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Calls per minute through Meterless (NVIDIA's trial endpoints rate-limit)
HANDOFF_RPM=20

# Optional fallback: the same Nemotron models on Nebius Token Factory, used only when
# Meterless keeps failing. Fallback answers are marked route=nebius-fallback.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# H-MEM helper (hmem/server.ts)
HMEM_URL=http://127.0.0.1:8790
